    "client": ["com.chughes102212.splitscreen.SplitScreenClient"]
  },
  "mixins": [],
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "1.21.11",
    "fabric-api": "*",
    "midnightcontrols": "*"
  }
}
````
